# Copy to .env and replace blanks with independently generated, high-entropy values.
# Avoid URI-reserved characters in APP_DB_PASSWORD/VALKEY_PASSWORD until URLs are encoded.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
VALKEY_PASSWORD=
INTERNAL_SERVICE_TOKEN=

# Bare DNS name Caddy serves. Required by compose.production.yaml and
# compose.split-domain.yaml. Not used by compose.plesk.yaml, where Plesk's nginx
# terminates TLS and proxies to the web container on 127.0.0.1:${WEB_PORT}.
APP_HOST=

# Canonical origin of the public website. Drives canonical URLs, hreflang, the
# sitemap and Open Graph. Must be a clean https origin (no path, no trailing slash).
PUBLIC_SITE_ORIGIN=
# Browser origin of the staff console and API.
#   local preview (base compose): leave blank to default to http://localhost:3000
#   single host (compose.production.yaml): the deployed https origin
#   split domain: the application host, e.g. https://platform.prachidham.com
PUBLIC_APP_ORIGIN=
# Comma-separated allowlist for mutating (non-GET) requests. Blank means
# "PUBLIC_APP_ORIGIN only". A split-domain deployment must list BOTH origins, e.g.
# https://prachidham.com,https://platform.prachidham.com
PUBLIC_ALLOWED_ORIGINS=

# Set to true only after the exact public content has been approved and published.
PUBLIC_SITE_INDEXABLE=false
# Catalog publishing requires approved translations in every listed language.
PUBLIC_REQUIRED_LOCALES=gu,hi,en
# Leave public contact-data collection off until the privacy notice/version and staff response workflow are approved.
PUBLIC_COMMERCE_INQUIRIES_ENABLED=false
COMMERCE_POLICY_VERSION=
PUBLIC_PRIVACY_POLICY_URL=

# Base Compose only: loopback port the web container publishes. Ignored by the
# production/split overlays, which route through Caddy instead.
WEB_PORT=3000

# Optional: needed only to enable the AI summarizer.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
